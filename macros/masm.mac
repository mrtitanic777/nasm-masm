;;
;; masm.mac
;;
;; MASM compatibility package; intended primarily for machine-generated code
;; (e.g. disassembly listings).  Auto-loaded by the `--masm' command-line flag.
;;
;; Covers: segment/ends (with USE16/USE32/USE64 -> BITS), proc/endp, ptr,
;; offset, flat, end, the .8086/.286/.386/.486/.586/.686[/p] CPU directives,
;; the FPU (.287/.387) and listing (title/page/subttl/name) directives, and
;; ASSUME -- the last several accepted and ignored.  It does NOT (yet) provide
;; symbol typing, INVOKE/PROTO, .IF/.WHILE, or MASM-style structures.
;;

USE: masm

%unimacro segment 1+

;; MASM: `NAME segment [align] [combine] [useNN] ['class']`.  Switch to a NASM
;; section named NAME.  The MASM-only attributes (align / combine / class) are
;; space-separated -- NASM splits macro args on commas, so they arrive as one
;; blob -- and carry no meaning for a flat `-f bin` assembly, so we swallow and
;; drop them (no "unknown section attribute" warnings).  Bitness comes from the
;; CPU directive (.386 etc.) or a standalone USE16/USE32/USE64; class/align
;; translation for the object backends is future work.
%imacro segment 0-1+.nolist
  ; Emit a NASM segment named NAME whose USE follows the current CPU mode
  ; (.386 -> use32), captured from __?BITS?__ before the section switch resets
  ; it to the segment default -- so the object backends (-f obj/coff) get 32-bit
  ; code and a USE32 header, and `-f bin' is unaffected (it has no segments).
  ; The MASM align/combine/class attributes (%1) are swallowed and dropped; they
  ; do not change the code bytes. Translating them to NASM's class=/align=/
  ; combine for a fully faithful object header is future work.
  %assign %%usebits __?BITS?__
  %ifidn __?OUTPUT_FORMAT?__, bin
    [segment %00]                        ; -f bin has no segments; USE is moot
  %else
    [segment %00 use %+ %%usebits]
  %endif
%endmacro

%imacro ends 0+.nolist
  %null ends %00
%endmacro

;; proc/endp/ret/invoke are the authoring-dialect PROC/INVOKE (Track B / B5),
;; defined further down.

%ifndef st
  %idefine st(x) st %+ x
%endif

%idefine ptr __?masm_ptr?__
;; OFFSET is handled in the parser under --masm (it must suppress the
;; data-label -> memory-reference conversion), so it is NOT redefined here.

%imacro end 0+.nolist
	; Nothing
%endmacro

%idefine tbyte tword

;; --- CPU selection directives (MASM: .8086/.286/.386/.486/.586/.686[/p]) ---
;; Leading-dot single-line macros are still preprocessor-expanded even at the
;; start of a line, which is how they can stand in for MASM's dot directives.
;;
;; In practice `.386' and up mark 32-bit code and `.286' and down 16-bit code,
;; so we map each to the corresponding BITS mode.  We deliberately do NOT emit
;; `[cpu N]' (which would *restrict* the instruction set): a compatibility
;; assembler for machine-generated listings should stay permissive, and the
;; CPU level never affects the byte encoding NASM chooses.  A standalone
;; USE16/USE32/USE64 (below) overrides for an individual segment.
%idefine .8086 [bits 16]
%idefine .186  [bits 16]
%idefine .286  [bits 16]
%idefine .286p [bits 16]
%idefine .386  [bits 32]
%idefine .386p [bits 32]
%idefine .486  [bits 32]
%idefine .486p [bits 32]
%idefine .586  [bits 32]
%idefine .586p [bits 32]
%idefine .686  [bits 32]
%idefine .686p [bits 32]
;; FPU selection directives have no effect on integer encoding: accept, ignore.
%idefine .8087
%idefine .287
%idefine .387
%idefine .387p

;; --- Listing / documentation directives: accepted and ignored ---
%imacro title 0-*.nolist
%endmacro
%imacro subtitle 0-*.nolist
%endmacro
%imacro subttl 0-*.nolist
%endmacro
%imacro page 0-*.nolist
%endmacro
%imacro name 0-*.nolist
%endmacro

;; --- ASSUME: segment-register assumptions are meaningless for a flat
;; assembler; accept and ignore so machine-generated source assembles. ---
%imacro assume 0-*.nolist
%endmacro

;; ===================================================================
;; Authoring dialect (Track B): the high-level MASM 6.x constructs used to
;; WRITE new code (as opposed to the machine-generated corpus above).  The
;; goal is functional MASM syntax -- assemble real source to working objects.
;; Instruction encodings follow nasm's corpus-matching choices (see
;; docs/MASM-COMPAT-ROADMAP.md), not necessarily ML byte-for-byte.
;; ===================================================================

;; Open a simplified-segment section named %1.  For the OMF backend a switch
;; resets BITS to the segment default, so carry USE from the current CPU mode;
;; COFF/bin are inherently flat and need no USE attribute.
%imacro __?masm_sect?__ 1.nolist
  %assign %%b __?BITS?__
  %ifidn __?OUTPUT_FORMAT?__, obj
    [section %1 use %+ %%b]
  %else
    [section %1]
  %endif
%endmacro

;; .MODEL memtype [, langtype] [, stackoption]
;; The flat model is 32-bit; the segmented models keep the current bitness and
;; are otherwise accepted.  A langtype (stdcall/c/pascal/...) is recorded for
;; PROC/INVOKE (Track B, later) in __?MASM_LANG?__.
%imacro .model 1-*.nolist
  %ifidni %1, flat
    [bits 32]
  %endif
  %if %0 >= 2
    %idefine __?MASM_LANG?__ %2
  %endif
%endmacro

;; Simplified segment directives.  Flat/32-bit code maps to NASM's standard
;; sections (correct default attributes on every backend).
%imacro .code 0-1.nolist
  %ifempty %1
    __?masm_sect?__ .text
  %else
    __?masm_sect?__ %1
  %endif
%endmacro
%imacro .data 0-1.nolist
  __?masm_sect?__ .data
%endmacro
%imacro .const 0-1.nolist
  __?masm_sect?__ .rodata
%endmacro
%imacro .stack 0-1.nolist
  ; flat model: the OS provides the stack; accept and ignore
%endmacro

;; ---- PROC / ENDP / RET / INVOKE / PROTO (B5) ------------------------------
;; Functional MASM procedures for the 32-bit flat model.  A PROC with a
;; parameter list gets a standard EBP frame; parameters become sized [ebp+N]
;; equates; RET emits the epilogue (LEAVE + a stack-cleaning RET for
;; stdcall/pascal).  A frameless PROC (no params) emits no prologue, matching
;; ML.  INVOKE pushes arguments right-to-left and calls, cleaning the stack for
;; the C convention.  Locals/USES and full type checking are future work.

%assign __?MASM_FRAME?__ 0      ; is an EBP frame active (affects RET)
%assign __?MASM_RETBYTES?__ 0   ; bytes for a stack-cleaning RET
%assign __?MASM_LOCALOFF?__ 0   ; running local-variable offset from EBP
%assign __?MASM_USESN?__ 0      ; count of USES registers to restore

;; Define one parameter "name:type" as a DWORD [ebp+off] equate.
%imacro __?masm_defparam?__ 2.nolist
  %defstr %%p %1
  %strlen %%len %%p
  %assign %%i 1
  %assign %%col 0
  %rep %%len
    %substr %%c %%p %%i
    %ifidn %%c, ':'
      %assign %%col %%i
      %exitrep
    %endif
    %assign %%i %%i+1
  %endrep
  %if %%col
    %substr %%nm %%p 1,%%col-1
  %else
    %defstr %%nm %1
  %endif
  %deftok %%nt %%nm
  %xdefine %[%%nt] dword [ebp+%2]
%endmacro

;; Record the registers of a `USES r1 r2 ...' clause (which arrives as one
;; space-joined argument) into __?MASM_USESREG1..N so the prologue can push them
;; after the frame and the epilogue pop them in reverse.
%imacro __?masm_uses_record?__ 1.nolist
  %defstr %%s %1
  %strlen %%n %%s
  %assign %%i 1
  %assign %%ts 0
  %assign %%first 1                     ; the first token is the word USES
  %rep %%n+1
    %if %%i > %%n
      %assign %%sp 1
    %else
      %substr %%ch %%s %%i
      %ifidn %%ch, ' '
        %assign %%sp 1
      %else
        %assign %%sp 0
      %endif
    %endif
    %if %%sp
      %if %%ts
        %if %%first
          %assign %%first 0
        %else
          %substr %%tok %%s %%ts,%%i-%%ts
          %deftok %%r %%tok
          %assign __?MASM_USESN?__ __?MASM_USESN?__+1
          %xdefine __?MASM_USESREG%[__?MASM_USESN?__] %[%%r]
        %endif
        %assign %%ts 0
      %endif
    %else
      %if %%ts == 0
        %assign %%ts %%i
      %endif
    %endif
    %assign %%i %%i+1
  %endrep
%endmacro

;; Does argument %1 contain a space?  The USES clause is the only PROC argument
;; that does (params are `name:type', langtypes are single words).
%imacro __?masm_argspace?__ 1.nolist
  %defstr %%s %1
  %strlen %%n %%s
  %assign __?MASM_ARGSPACE?__ 0
  %assign %%i 1
  %rep %%n
    %substr %%ch %%s %%i
    %ifidn %%ch, ' '
      %assign __?MASM_ARGSPACE?__ 1
      %exitrep
    %endif
    %assign %%i %%i+1
  %endrep
%endmacro

%imacro proc 0-*.nolist
  %00:                                  ; define the procedure label
  %assign __?MASM_LOCALOFF?__ 0
  %assign __?MASM_USESN?__ 0
  %assign %%off 8                       ; first parameter is at [ebp+8]
  %assign %%pbytes 0
  ;; default calling convention from .MODEL; an explicit PROC langtype overrides
  %assign %%cdecl 0
  %ifdef __?MASM_LANG?__
    %ifidni __?MASM_LANG?__, c
      %assign %%cdecl 1
    %endif
  %endif
  %rep %0
    __?masm_argspace?__ %1
    %if __?MASM_ARGSPACE?__
      __?masm_uses_record?__ %1         ; the USES reglist (only arg with a space)
    %elifidni %1,c
      %assign %%cdecl 1
    %elifidni %1,syscall
      %assign %%cdecl 1
    %elifidni %1,stdcall
      %assign %%cdecl 0
    %elifidni %1,pascal
      %assign %%cdecl 0
    %elifidni %1,near
    %elifidni %1,far
    %elifidni %1,near32
    %elifidni %1,far32
    %elifidni %1,public
    %elifidni %1,private
    %elifidni %1,export
    %else
      __?masm_defparam?__ %1, %%off     ; a parameter: name:type
      %assign %%off %%off+4
      %assign %%pbytes %%pbytes+4
    %endif
    %rotate 1
  %endrep
  %if %%pbytes
    push ebp
    mov ebp, esp
    %assign __?MASM_FRAME?__ 1
  %else
    %assign __?MASM_FRAME?__ 0
  %endif
  ;; push the USES registers after the frame; locals then sit below them
  %if __?MASM_USESN?__
    %assign %%k 1
    %rep __?MASM_USESN?__
      push __?MASM_USESREG%[%%k]
      %assign %%k %%k+1
    %endrep
    %assign __?MASM_LOCALOFF?__ 4*__?MASM_USESN?__
  %endif
  %if %%cdecl
    %assign __?MASM_RETBYTES?__ 0        ; caller cleans
  %else
    %assign __?MASM_RETBYTES?__ %%pbytes ; stdcall/pascal: callee cleans
  %endif
%endmacro

%imacro endp 0.nolist
  %null endp %00                        ; consume the label (don't redefine it)
  %assign __?MASM_FRAME?__ 0
  %assign __?MASM_RETBYTES?__ 0
%endmacro

;; LOCAL var:type [, ...] -- stack locals at [ebp-N].  Establishes the EBP frame
;; if the PROC had no parameters, then reserves space (one `add esp,-total' per
;; LOCAL directive, as ML emits) and binds each name to a DWORD [ebp-N] equate.
;; (Type widths and arrays are future work: locals are treated as DWORD.)
%imacro __?masm_deflocal?__ 1.nolist
  %defstr %%p %1
  %strlen %%len %%p
  %assign %%i 1
  %assign %%col 0
  %rep %%len
    %substr %%c %%p %%i
    %ifidn %%c, ':'
      %assign %%col %%i
      %exitrep
    %endif
    %assign %%i %%i+1
  %endrep
  %if %%col
    %substr %%nm %%p 1,%%col-1
  %else
    %defstr %%nm %1
  %endif
  %deftok %%nt %%nm
  %assign __?MASM_LOCALOFF?__ __?MASM_LOCALOFF?__+4
  %xdefine %[%%nt] dword [ebp-__?MASM_LOCALOFF?__]
%endmacro

%imacro local 1-*.nolist
  %if __?MASM_FRAME?__ == 0
    push ebp
    mov ebp, esp
    %assign __?MASM_FRAME?__ 1
  %endif
  %assign %%before __?MASM_LOCALOFF?__
  %rep %0
    __?masm_deflocal?__ %1
    %rotate 1
  %endrep
  add esp, -(__?MASM_LOCALOFF?__ - %%before)
%endmacro

;; RET emits the procedure epilogue.  Outside a frame it is a plain near RET,
;; so the machine-generated corpus (which never opens a PROC) is unaffected.
%imacro ret 0-1.nolist
  %if __?MASM_USESN?__
    %assign %%k __?MASM_USESN?__          ; restore USES registers in reverse
    %rep __?MASM_USESN?__
      pop __?MASM_USESREG%[%%k]
      %assign %%k %%k-1
    %endrep
  %endif
  %if __?MASM_FRAME?__
    leave
  %endif
  %if %0 == 1
    retn %1
  %elif __?MASM_RETBYTES?__
    retn __?MASM_RETBYTES?__
  %else
    retn
  %endif
%endmacro

%idefine addr offset                    ; INVOKE ... ADDR x  ->  the address of x

;; INVOKE target, arg, ...  -- push args right-to-left, call, clean for C.
%imacro invoke 1-*.nolist
  %if %0 > 1
    %rep %0-1
      %rotate -1
      push %1
    %endrep
    %rotate -1                          ; back to the target
  %endif
  call %1
  %if %0 > 1
    %ifdef __?MASM_LANG?__
      %ifidni __?MASM_LANG?__, c
        add esp, 4*(%0-1)
      %endif
    %endif
  %endif
%endmacro

;; PROTO declares an (often external) procedure so INVOKE can call it.
%imacro proto 0-*.nolist
  extern %00
%endmacro

	default rel
